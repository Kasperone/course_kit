# Local-only secrets. Copy this file to .env next to course.json (gitignored; chmod 600) and fill
# in what you use. Never commit .env. `course serve` / `course dev` / `course narrate` read the keys
# at runtime; they are never logged and never reach the browser (the deck only talks to the local
# backend on 127.0.0.1).

# Q&A chat answers (Claude). Without it the chat panel says "no API key".
ANTHROPIC_API_KEY=

# Optional: ElevenLabs narration (`course narrate --provider elevenlabs`) and voice input (Scribe).
ELEVENLABS_API_KEY=
